# Parivar Arth - Environment Configuration Template
# Copy this file to .env and configure appropriately

# App environment: development, staging, production
ENVIRONMENT=development

# Database Connection (defaults to local SQLite if omitted)
# For local SQLite:
DATABASE_URL=sqlite:///./parivar_arth.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://db_user:your_secure_password@localhost:5432/parivar_arth

# Application Secret Key for session signatures
SECRET_KEY=your_random_secret_key_here_change_in_production

# LLM API Provider for AI Financial Chatbot (optional; offline TF-IDF FAQ used if blank)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here

# SMTP Email Configuration for Password Reset (optional; console fallback used if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=Parivar Arth <noreply@parivararth.in>

# Admin Initial Seed Token
ADMIN_INIT_TOKEN=your_admin_seed_token_here
