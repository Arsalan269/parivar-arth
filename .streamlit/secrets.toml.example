# Parivar Arth - Streamlit Secrets Template
# Rename this file to secrets.toml in production or Streamlit Cloud

# Database connection:
# Default is local SQLite (leave blank or specify sqlite:///./parivar_arth.db)
# For production PostgreSQL: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL = "sqlite:///./parivar_arth.db"

# SMTP Email Configuration (optional; defaults to local console fallback for reset tokens)
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = 587
# SMTP_USER = "noreply@parivararth.in"
# SMTP_PASSWORD = "your_app_password_here"
# SMTP_FROM = "Parivar Arth <noreply@parivararth.in>"
